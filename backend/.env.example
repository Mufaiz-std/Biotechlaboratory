# Database (URL-encode special chars in password, e.g. @ → %40)
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/lab_booking

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Cloudinary (Phase 5+)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App
APP_ENV=development

# Admin/Technician Accounts
ADMIN_1_PHONE=+919876543210
ADMIN_1_PASSWORD=password123
ADMIN_1_NAME=Super Admin
ADMIN_2_PHONE=+919876543211
ADMIN_2_PASSWORD=password123
ADMIN_2_NAME=Technician 1
